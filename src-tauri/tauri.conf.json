{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folium PDF",
  "version": "0.4.0",
  "identifier": "io.github.airpj.foliumpdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folium PDF",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Folium PDF contributors",
    "homepage": "https://github.com/AirPJ/folium-pdf",
    "license": "GPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Free, ad-free, offline PDF tool",
    "longDescription": "Read, organize and combine PDF files. Everything happens on your computer: no account, no uploads, no ads.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwOTMwNjE2QjY2N0Y5RTUKUldUbCtXZTJGZ2FUNE8ycnFZTisyUmJUZ3dEaGI0V2FNK2VwZTNGbVFvTUZ6ODc3OHN3M1hmQnMK",
      "endpoints": [
        "https://github.com/AirPJ/folium-pdf/releases/download/test-build/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
